# Environment Variables — ContractCommand P07 Backend
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# Django Core
SECRET_KEY=your-very-long-random-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Selection (Set to True for SQLite fallback, False for MySQL 8.0)
USE_SQLITE=True

# MySQL Database (Required when USE_SQLITE=False)
DB_NAME=contractcommand_db
DB_USER=contractcommand_user
DB_PASSWORD=your-mysql-password-here
DB_HOST=localhost
DB_PORT=3306

# CORS (comma-separated origins for frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://contract-command-defence.vercel.app,https://contract-command-indol.vercel.app
CSRF_TRUSTED_ORIGINS=https://contract-command-defence.vercel.app,https://contract-command-indol.vercel.app,https://*.onrender.com,https://*.vercel.app
